{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "registry.schema.json",
  "title": "AI Infra Index aggregate",
  "description": "Generated, deterministic aggregate consumed by the site and external tools.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "collection", "count", "source", "groups", "categories", "plugins"],
  "properties": {
    "schema": { "const": 1 },
    "collection": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "count": { "type": "integer", "minimum": 0 },
    "source": { "const": "plugins/*.yaml" },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "order"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "note": { "type": "string" },
          "order": { "type": "integer" }
        }
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "group", "title", "order"],
        "properties": {
          "id": { "type": "string" },
          "group": { "type": "string" },
          "title": { "type": "string" },
          "order": { "type": "integer" }
        }
      }
    },
    "plugins": {
      "type": "array",
      "items": { "$ref": "plugin.schema.json" }
    }
  }
}
